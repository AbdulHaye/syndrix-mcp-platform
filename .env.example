# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=
SECRET_KEY=
API_HOST=
API_PORT=

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=

# ── Ollama (local LLM) ────────────────────────────────────────────────────────
OLLAMA_BASE_URL=
OLLAMA_DEFAULT_MODEL=
OLLAMA_EMBED_MODEL=

# ── JWT Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=480

# ── Bootstrap admin (auto-created on first startup if no admin exists) ────────
ADMIN_EMAIL=admin@syndrix.local
ADMIN_PASSWORD=changeme

# ── DEV_TOKENS — static fallback tokens for testing (leave empty in prod) ────
DEV_TOKENS=

