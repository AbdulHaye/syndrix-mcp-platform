# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=
SECRET_KEY=
API_HOST=
API_PORT=

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=

# ── Ollama (local LLM) ────────────────────────────────────────────────────────
OLLAMA_BASE_URL=
OLLAMA_DEFAULT_MODEL=
OLLAMA_EMBED_MODEL=

# ── JWT Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=480

# ── Bootstrap admin (auto-created on first startup if no admin exists) ────────
ADMIN_EMAIL=admin@syndrix.local
ADMIN_PASSWORD=changeme

# ── DEV_TOKENS — static fallback tokens for testing (leave empty in prod) ────
DEV_TOKENS=

# ── CORS_ORIGINS — comma-separated list of extra allowed frontend origins ────
# http://localhost:3000 is always allowed regardless of this setting. Add the
# deployed frontend's origin here (scheme + host + port, no trailing slash),
# e.g. http://195.35.14.71:3100 — otherwise the browser's preflight OPTIONS
# request to /auth/login (and every other API call) gets rejected and the
# frontend sees a generic "Failed to fetch".
CORS_ORIGINS=

# ── Langfuse (LLM observability/tracing — https://langfuse.com) ───────────────
# Read directly by the langfuse SDK via os.environ. Paste your project's keys
# from Langfuse Cloud (Settings -> API Keys), then set TRACING_ENABLED=true
# (or delete that line — true is the SDK's own default). LANGFUSE_BASE_URL
# MUST match the region your Langfuse project actually lives in — a key from
# one region 401s against every other region's host, with no other symptom
# (confirmed live): EU = https://cloud.langfuse.com (default if unset),
# US = https://us.cloud.langfuse.com, Japan = https://jp.cloud.langfuse.com.
# Check Settings -> API Keys in your Langfuse project for the right one.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_TRACING_ENABLED=false

