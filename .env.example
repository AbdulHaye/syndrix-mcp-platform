# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=
SECRET_KEY=
API_HOST=
API_PORT=

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=

# ── Ollama (local LLM) ────────────────────────────────────────────────────────
OLLAMA_BASE_URL=
OLLAMA_DEFAULT_MODEL=
OLLAMA_EMBED_MODEL=

# ── Auth tokens (format: team_name:token,team_name:token) ─────────────────────
DEV_TOKENS=

# ── Integration credentials ───────────────────────────────────────────────────
# Podio, GoHighLevel, Slack, GitHub, and SMTP credentials are managed via
# the Settings page in the UI (/dashboard/settings), not environment variables.
