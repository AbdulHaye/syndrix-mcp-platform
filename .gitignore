# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# ── Virtual environments ──────────────────────────────────────────────────────
env/
venv/
.venv/
ENV/

# ── Environment (never commit real secrets) ───────────────────────────────────
.env
.env.*.local

# ── Database ──────────────────────────────────────────────────────────────────
*.db
*.sqlite3

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Testing ───────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ── Type checking ─────────────────────────────────────────────────────────────
.mypy_cache/
.ruff_cache/

# ── IDE ───────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Alembic generated bytecode ────────────────────────────────────────────────
alembic/versions/__pycache__/

# ── Node (frontend subdirectory handled by frontend/.gitignore) ──────────────
frontend/node_modules/
frontend/.next/
